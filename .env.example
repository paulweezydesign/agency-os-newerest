# Never use example secrets in deployed environments.
AUTH_SECRET=replace-with-a-strong-random-secret
AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/agencyos
# GitHub OAuth app; for production set these via your deployment secret manager.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AGENCYOS_GITHUB_ADMIN_IDS=
# AGENCYOS_GITHUB_OPERATOR_IDS=
# Demo passwords are registered only when NODE_ENV=development AND this is true.
AGENCYOS_ENABLE_DEMO_AUTH=false
# Synthetic .test workflow, local development or protected Preview only.
AGENCYOS_DRY_RUN_WORKFLOW=false
# Bounded fictional Task -> brief via the OpenAI Responses API. Off by default.
# See docs/openai-bounded-provider.md before enabling; Mongo must be a replica set.
AGENCYOS_AGENT_RUN_ENABLED=false
# AGENCYOS_AGENT_RUN_TENANT_ID=tenant-default
# AGENCYOS_AGENT_RUN_PROJECT_ID=<existing-fictional-project-id>
# AGENCYOS_AGENT_RUN_MODEL=gpt-6-astra
# Set OPENAI_API_KEY yourself in the server environment or ignored .env.local.
# Never use NEXT_PUBLIC_ for the key or put it in browser requests, chat, or Git.
# OPENAI_API_KEY=
